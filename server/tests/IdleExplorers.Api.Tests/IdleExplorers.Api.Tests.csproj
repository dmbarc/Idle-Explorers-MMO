<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Scenario tests over real HTTP, against the real application.

    WebApplicationFactory boots the SAME Program.Build the container runs, so these
    exercise the actual middleware pipeline, the actual auth, and the actual database.
    A test that constructs a different application proves something nobody ships.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>IdleExplorers.Api.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Npgsql" Version="9.0.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IdleExplorers.Api/IdleExplorers.Api.csproj" />
  </ItemGroup>

</Project>

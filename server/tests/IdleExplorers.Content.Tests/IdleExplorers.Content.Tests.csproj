<Project Sdk="Microsoft.NET.Sdk">

  <!--
    These tests read the REAL twelve files out of Assets/StreamingAssets. That is the
    point of them: a catalogue that loads a fixture proves the loader compiles, and a
    catalogue that loads the shipping content proves the game is authored correctly.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>IdleExplorers.Content.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IdleExplorers.Content/IdleExplorers.Content.csproj" />
  </ItemGroup>

</Project>

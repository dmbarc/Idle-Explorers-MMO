<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Operator commands: exporting telemetry, and looking at one character.

    Separate from the API because these are things a person runs, not things a
    player triggers. Putting them behind HTTP would mean designing authentication
    for an audience of one and leaving an admin surface exposed forever.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IdleExplorers.Tools</RootNamespace>
    <AssemblyName>IdleExplorers.Tools</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../IdleExplorers.Rules/IdleExplorers.Rules.csproj" />
  </ItemGroup>

</Project>
